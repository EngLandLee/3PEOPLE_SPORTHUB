# ==============================================================================
# SPORTHUB ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Supabase PostgreSQL & Realtime Configuration
# Get these values from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 2. Vite Web Admin Environment Variables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 3. Optional Direct Gmail SMTP (Google App Password)
# GMAIL_SENDER_EMAIL=your-sender@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 4. Running Flutter with Supabase & Gmail keys:
# flutter run -d chrome --dart-define=SUPABASE_URL=https://your-project-id.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key --dart-define=GMAIL_SENDER_EMAIL=... --dart-define=GMAIL_APP_PASSWORD=...

